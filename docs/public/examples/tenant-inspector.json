        "source": "defineDataView({\n  mode: 'projection',\n  output: {\n    tenant: facet('tenant'),\n    title: concat(config('inspector.title'), ' ', path('number')),\n    sections: config('inspector.sections').map({\n      title: get('title'),\n      fields: get('fields').map({\n        label: get('label'),\n        format: get('format'),\n        value: get(path(''), get('path')),\n      }),\n    }),\n  },\n})",
        "sourceVersion": 1
      }
